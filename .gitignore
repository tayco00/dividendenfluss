# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Local portfolio data, imports, and exports must never enter the repository
/user-data/
/data/private/
/backups/
/exports/
dividenden-backup-*.json
portfolio-export-*.csv
dividenden-export-*.csv
*.xlsx
*.xls

# Local development output
/dev.stdout.log
/dev.stderr.log
/.tmp-spreadsheet/
*.tsbuildinfo

# Windows launcher: publish only portable app files, never machine-specific state
/.runtime/
/.launcher/legacy-shortcuts/
/.launcher/*-source.png
/.launcher/*-preview.png
/.launcher/*.lnk
