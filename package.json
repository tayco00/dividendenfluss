{
  "name": "dividendenfluss",
  "version": "0.2.2",
  "description": "Dividendenfluss",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop:build": "tsc --noEmit -p tsconfig.desktop.json && vite build --config desktop.vite.config.ts",
    "desktop:package": "npm run desktop:build && electron-builder --win nsis --x64 --publish never",
    "test": "npm run build && node --import tsx --test tests/rendered-html.test.mjs tests/desktop-update.test.mjs tests/csv-legacy.test.ts tests/settings.test.ts tests/profiles.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern desktop-dist --ignore-pattern desktop-release --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "electron-updater": "^6.8.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "de.dividendenfluss.app",
    "productName": "Dividendenfluss",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop-dist/**/*",
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "desktop/startup-window.mjs",
      "desktop/startup.html",
      "desktop/startup-renderer.js",
      "desktop/update-service.mjs",
      "desktop/window-state.mjs",
      "desktop/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tayco00",
        "repo": "dividendenfluss",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png",
      "artifactName": "Dividendenfluss.${ext}"
    },
    "nsis": {
      "artifactName": "Dividendenfluss-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dividendenfluss",
      "uninstallDisplayName": "Dividendenfluss"
    }
  }
}
